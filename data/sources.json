{
  "pypi": {
    "name": "PyPI (Python)",
    "command": "pip install <package> -i {url}",
    "config": "# ~/.pip/pip.conf\n[global]\nindex-url = {url}",
    "abis": {
      "1": "https://pypi.loongnix.cn/loongson/pypi/+simple",
      "2": "https://lpypi.loongnix.cn/loongson/pypi/+simple"
    }
  },
  "npm": {
    "name": "npm (Node.js)",
    "command": "npm config set registry {url}",
    "config": "// .npmrc\nregistry = \"{url}\"",
    "abis": {
      "1": "https://registry.loongnix.cn",
      "2": "https://registry.loongnix.cn"
    }
  },
  "maven": {
    "name": "Maven (Java)",
    "command": "",
    "config": "<!-- settings.xml -->\n<mirror>\n  <id>loongarch</id>\n  <url>{url}</url>\n</mirror>",
    "abis": {
      "1": "https://maven.loongnix.cn/loongarchabi1/maven",
      "2": "https://maven.loongnix.cn/loongarch/maven"
    }
  }
}
