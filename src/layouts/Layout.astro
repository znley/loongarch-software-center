---
import { getDistros } from '../lib/data';
import '../styles/global.css';

export interface Props {
  title: string;
  lang?: string;
}

const { title, lang = "zh" } = Astro.props;
const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
const distros = getDistros();

const allVersions = distros.flatMap((d, distroIndex) => 
  d.versions.map((v, versionIndex) => ({
    id: distroIndex * 100 + versionIndex,
    distro: d.distro,
    version: v.version,
    display_name: d.display_name + ' ' + v.version,
    logo_url: d.logo_url,
    iso_download_url: v.iso_download_url,
    abi: v.abi
  }))
);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} - 龙架构软件中心</title>
    <style>
      :root {
        --color-primary: #2563eb;
        --color-primary-hover: #1d4ed8;
      }
    </style>
  </head>
  <body class="bg-gray-50 min-h-screen">
    <header class="bg-white border-b border-gray-200 sticky top-0 z-50">
      <div class="max-w-6xl mx-auto px-4">
        <div class="flex items-center justify-between h-16">
          <a href={base} class="flex items-center gap-2">
            <span class="text-xl font-bold text-gray-800">龙架构软件中心</span>
          </a>

          <nav class="hidden md:flex items-center gap-6">
            <a href={base} class="nav-link text-sm font-medium text-gray-600 hover:text-blue-600 transition">首页</a>
            <a href={`${base}iso`} class="nav-link text-sm font-medium text-gray-600 hover:text-blue-600 transition">系统下载</a>
            <a href={`${base}sources`} class="nav-link text-sm font-medium text-gray-600 hover:text-blue-600 transition">软件源</a>
            <a href={`${base}registry`} class="nav-link text-sm font-medium text-gray-600 hover:text-blue-600 transition">容器镜像</a>
            <a href={`${base}packages`} class="nav-link text-sm font-medium text-gray-600 hover:text-blue-600 transition">软件包</a>
          </nav>

          <div class="flex items-center gap-3">
            <label class="text-sm text-gray-500">操作系统:</label>
            <select
              id="os-selector"
              class="border border-gray-300 rounded px-3 py-1.5 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-blue-500"
            >
              <option value="">选择操作系统...</option>
            </select>
          </div>
        </div>
      </div>
    </header>

    <!-- 全局提示 -->
    <div id="global-hint" class="hidden bg-blue-50 border-b border-blue-100">
      <div class="max-w-6xl mx-auto px-4 py-2 text-center">
        <span class="text-sm text-blue-700">
          当前系统：<span id="current-system" class="font-medium"></span>
          <span class="text-blue-500 ml-2">以下内容仅适用于该系统</span>
        </span>
      </div>
    </div>

    <main class="max-w-6xl mx-auto px-4 py-8">
      <slot />
    </main>

    <footer class="border-t border-gray-200 mt-12">
      <div class="max-w-6xl mx-auto px-4 py-6 text-center text-sm text-gray-500">
        LoongArch Software Center
      </div>
    </footer>

    <script define:vars={{ allVersions }}>
      const STORAGE_KEY = 'lasc_selected_os';

      function initSelector() {
        const selector = document.getElementById('os-selector');
        if (!selector) return;

        allVersions.forEach((d) => {
          const option = document.createElement('option');
          option.value = d.id.toString();
          option.textContent = d.display_name;
          option.dataset.abi = d.abi.toString();
          option.dataset.isoUrl = d.iso_download_url;
          selector.appendChild(option);
        });

        const savedId = localStorage.getItem(STORAGE_KEY);
        if (savedId) {
          selector.value = savedId;
        }

        selector.addEventListener('change', updateAbiInfo);
      }

      function updateAbiInfo() {
        const selector = document.getElementById('os-selector');
        const selectedOption = selector?.options[selector.selectedIndex];
        const globalHint = document.getElementById('global-hint');
        const currentSystem = document.getElementById('current-system');

        if (selectedOption && selectedOption.value) {
          const abi = selectedOption.dataset.abi;
          const isoUrl = selectedOption.dataset.isoUrl;

          localStorage.setItem(STORAGE_KEY, selector.value);
          localStorage.setItem('lasc_abi', abi || '');
          localStorage.setItem('lasc_iso_url', isoUrl || '');

          // 显示全局提示
          if (globalHint && currentSystem) {
            currentSystem.textContent = selectedOption.textContent;
            globalHint.classList.remove('hidden');
          }

          window.dispatchEvent(new CustomEvent('osChanged', {
            detail: { abi, isoUrl, distroId: selector.value }
          }));
        } else {
          // 未选择系统，移除提示
          if (globalHint) {
            globalHint.classList.add('hidden');
          }
        }
      }

      document.addEventListener('DOMContentLoaded', () => {
        initSelector();
        updateAbiInfo();
      });

      if (document.readyState !== 'loading') {
        initSelector();
        updateAbiInfo();
      }
    </script>
  </body>
</html>

<style is:global>
  .nav-link.active {
    color: #2563eb;
    font-weight: 600;
  }
</style>
