---
import Layout from '../layouts/Layout.astro';
import { getEndpoints } from '../lib/data';

const endpoints = getEndpoints();
const packagesConfig = endpoints['packages'];
---

<Layout title="软件包">
  <div class="max-w-2xl mx-auto">
    <h1 class="text-2xl font-bold mb-2 text-center text-gray-800">软件包</h1>
    <p class="text-gray-500 text-center mb-8">浏览和下载适用于 LoongArch 的软件包</p>

    <div id="no-os-hint" class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 mb-8">
      <p class="text-yellow-800 text-sm font-medium">
        请先在右上角选择您的操作系统
      </p>
    </div>

    <div id="packages-container" class="hidden">
      <div class="bg-white border border-gray-200 rounded-lg p-6">
        <div class="flex items-center justify-between mb-4">
          <h2 class="font-medium text-gray-800">软件包服务器</h2>
          <a id="packages-link" href="#" target="_blank" class="text-sm text-blue-500 hover:text-blue-600">浏览软件包 →</a>
        </div>
        <div class="bg-gray-50 border border-gray-100 rounded px-4 py-3">
          <code id="packages-url" class="text-sm text-gray-700 break-all"></code>
        </div>
      </div>
    </div>
  </div>

  <script define:vars={{ packagesConfig }}>
    function updatePackages() {
      const abi = localStorage.getItem('lasc_abi');
      const noOsHint = document.getElementById('no-os-hint');
      const container = document.getElementById('packages-container');

      if (!abi || !packagesConfig) {
        noOsHint?.classList.remove('hidden');
        container?.classList.add('hidden');
        return;
      }

      const url = packagesConfig.abis[abi];
      if (!url) {
        noOsHint?.classList.remove('hidden');
        container?.classList.add('hidden');
        return;
      }

      noOsHint?.classList.add('hidden');
      container?.classList.remove('hidden');

      document.getElementById('packages-url').textContent = url;
      document.getElementById('packages-link').href = url;
    }

    window.addEventListener('osChanged', updatePackages);

    document.addEventListener('DOMContentLoaded', () => {
      const savedAbi = localStorage.getItem('lasc_abi');
      if (savedAbi) {
        updatePackages();
      }
    });
  </script>
</Layout>
