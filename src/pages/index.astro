---
import Layout from '../layouts/Layout.astro';

const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
---

<Layout title="首页">
  <div class="text-center py-12">
    <h1 class="text-3xl font-bold mb-3">龙架构软件中心</h1>
    <p class="text-gray-600 text-lg mb-8">
      选择你的操作系统，获取软件源和软件包信息。
    </p>

    <!-- 未选择系统提示 -->
    <div id="no-os-hint" class="max-w-lg mx-auto mb-8">
      <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-6">
        <div class="flex items-center gap-3 mb-3">
          <img src={`${base}icons/warning.svg`} alt="警告" class="w-8 h-8">
          <p class="text-yellow-800 font-medium">请先选择您的操作系统</p>
        </div>
        <p class="text-yellow-700 text-sm mb-4">
          在右上角选择您要使用的操作系统，以获取正确的软件源和配置信息。
        </p>
        <p class="text-yellow-600 text-xs">
          请勿混用
        </p>
      </div>
    </div>

    <!-- 功能入口 -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
      <a href={`${base}iso`} class="block border border-gray-200 rounded-lg p-6 hover:border-blue-300 hover:shadow-md transition bg-white">
        <div class="flex items-center gap-4">
          <img src={`${base}icons/disc.svg`} alt="光盘" class="w-10 h-10">
          <div>
            <h2 class="text-lg font-semibold text-gray-800">系统下载</h2>
            <p class="text-sm text-gray-500 mt-1">下载 LoongArch 操作系统 ISO 镜像</p>
          </div>
        </div>
      </a>

      <a href={`${base}sources`} class="block border border-gray-200 rounded-lg p-6 hover:border-blue-300 hover:shadow-md transition bg-white">
        <div class="flex items-center gap-4">
          <img src={`${base}icons/package.svg`} alt="包裹" class="w-10 h-10">
          <div>
            <h2 class="text-lg font-semibold text-gray-800">软件源</h2>
            <p class="text-sm text-gray-500 mt-1">配置 PyPI、npm、Maven 等软件源</p>
          </div>
        </div>
      </a>

      <a href={`${base}registry`} class="block border border-gray-200 rounded-lg p-6 hover:border-blue-300 hover:shadow-md transition bg-white">
        <div class="flex items-center gap-4">
          <img src={`${base}icons/whale.svg`} alt="鲸鱼" class="w-10 h-10">
          <div>
            <h2 class="text-lg font-semibold text-gray-800">容器镜像</h2>
            <p class="text-sm text-gray-500 mt-1">访问容器镜像仓库</p>
          </div>
        </div>
      </a>

      <a href={`${base}packages`} class="block border border-gray-200 rounded-lg p-6 hover:border-blue-300 hover:shadow-md transition bg-white">
        <div class="flex items-center gap-4">
          <img src={`${base}icons/folder.svg`} alt="文件夹" class="w-10 h-10">
          <div>
            <h2 class="text-lg font-semibold text-gray-800">软件包</h2>
            <p class="text-sm text-gray-500 mt-1">浏览和下载软件包</p>
          </div>
        </div>
      </a>
    </div>
  </div>

  <script>
    function updateNoOsHint() {
      const noOsHint = document.getElementById('no-os-hint');
      const savedAbi = localStorage.getItem('lasc_abi');
      
      if (savedAbi && noOsHint) {
        noOsHint.classList.add('hidden');
      }
    }

    window.addEventListener('osChanged', updateNoOsHint);

    document.addEventListener('DOMContentLoaded', () => {
      updateNoOsHint();
    });
  </script>
</Layout>
