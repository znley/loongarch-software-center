---
import Layout from '../layouts/Layout.astro';
import { getDistros } from '../lib/data';

const distros = getDistros();
const distroTypes = [...new Set(distros.map(d => d.distro))];
---

<Layout title="系统下载">
  <div class="max-w-3xl mx-auto">
    <h1 class="text-2xl font-bold mb-2 text-center text-gray-800">系统下载</h1>
    <p class="text-gray-500 text-center mb-8">选择您要下载的 LoongArch 操作系统</p>

    <div class="flex justify-center mb-8">
      <div class="relative">
        <select
          id="os-type-select"
          class="appearance-none bg-white border border-gray-200 rounded-md px-4 py-2 pr-8 text-sm text-gray-700 focus:outline-none focus:border-blue-400 cursor-pointer"
        >
          <option value="">全部操作系统</option>
          {distroTypes.map(type => (
            <option value={type}>{type}</option>
          ))}
        </select>
        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-gray-400">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </div>
      </div>
    </div>

    <div id="iso-list" class="hidden"></div>

    <div id="no-result" class="hidden text-center text-gray-400 py-12">
      <p class="text-sm">暂无可用的 ISO 镜像</p>
    </div>
  </div>

  <script define:vars={{ distros }}>
    const allVersions = distros.flatMap((d) => 
      d.versions.map((v) => ({
        distro: d.distro,
        version: v.version,
        display_name: d.display_name + ' ' + v.version,
        logo_url: d.logo_url,
        iso_download_url: v.iso_download_url
      }))
    );

    function renderRow(d) {
      const icon = d.logo_url
        ? '<img src="' + d.logo_url + '" alt="' + d.distro + '" class="w-8 h-8 object-contain rounded">'
        : '<img src="/icons/penguin.svg" alt="企鹅" class="w-8 h-8">';

      return '<div class="flex items-center justify-between bg-white border border-gray-300 rounded-lg px-5 py-4 mb-3 hover:border-gray-400 transition">' +
        '<div class="flex items-center gap-4">' +
        icon +
        '<div>' +
        '<span class="text-sm font-medium text-gray-800 block">' + d.display_name + '</span>' +
        '</div>' +
        '</div>' +
        '<a href="' + d.iso_download_url + '" target="_blank" class="px-4 py-2 bg-white border border-gray-300 text-gray-600 text-sm rounded hover:border-gray-400 hover:text-gray-800 transition">下载</a>' +
        '</div>';
    }

    function renderList(distroType) {
      const isoList = document.getElementById('iso-list');
      const noResult = document.getElementById('no-result');
      let filtered = allVersions;

      if (distroType) {
        filtered = allVersions.filter(d => d.distro === distroType);
      }

      if (filtered.length === 0) {
        isoList.classList.add('hidden');
        noResult.classList.remove('hidden');
        return;
      }

      noResult.classList.add('hidden');
      isoList.innerHTML = filtered.map(renderRow).join('');
      isoList.classList.remove('hidden');
    }

    document.getElementById('os-type-select').addEventListener('change', (e) => {
      renderList(e.target.value);
    });

    renderList('');
  </script>
</Layout>
