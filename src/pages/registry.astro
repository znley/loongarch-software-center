---
import Layout from '../layouts/Layout.astro';
import { getEndpoints } from '../lib/data';

const endpoints = getEndpoints();
const registryConfig = endpoints['container_registry'];
---

<Layout title="容器镜像">
  <div class="max-w-2xl mx-auto">
    <h1 class="text-2xl font-bold mb-8 text-center text-gray-800">容器镜像仓库</h1>

    <div id="no-os-hint" class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 mb-8">
      <p class="text-yellow-800 text-sm">
        请先在右上角选择您的操作系统，以获取对应的镜像仓库地址。
      </p>
    </div>

    <div id="registry-container" class="hidden bg-white border border-gray-100 rounded-lg p-6">
      <div class="mb-5">
        <p class="text-xs text-gray-400 mb-1.5">镜像仓库地址</p>
        <code id="registry-url" class="block bg-gray-50 px-3 py-2 rounded text-sm text-gray-700 break-all"></code>
      </div>

      <div class="border-t border-gray-100 pt-4 mb-5">
        <p class="text-xs text-gray-400 mb-1.5">拉取镜像</p>
        <code id="pull-command" class="block bg-gray-50 px-3 py-2 rounded text-sm text-gray-700 overflow-x-auto"></code>
      </div>

      <div class="border-t border-gray-100 pt-4">
        <p class="text-xs text-gray-400 mb-1.5">Docker 配置</p>
        <pre class="bg-gray-50 px-3 py-2 rounded text-sm text-gray-700 overflow-x-auto whitespace-pre-wrap"><code id="docker-config"></code></pre>
      </div>
    </div>
  </div>

  <script define:vars={{ registryConfig }}>
    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    function updateRegistry() {
      const abi = localStorage.getItem('lasc_abi');
      const noOsHint = document.getElementById('no-os-hint');
      const container = document.getElementById('registry-container');

      if (!abi || !registryConfig) {
        noOsHint?.classList.remove('hidden');
        container?.classList.add('hidden');
        return;
      }

      const url = registryConfig.abis[abi];
      if (!url) {
        noOsHint?.classList.remove('hidden');
        container?.classList.add('hidden');
        return;
      }

      noOsHint?.classList.add('hidden');
      container?.classList.remove('hidden');

      document.getElementById('registry-url').textContent = url;
      document.getElementById('pull-command').textContent = registryConfig.command.replace('{url}', url);
      document.getElementById('docker-config').textContent = registryConfig.config.replace('{url}', url);
    }

    window.addEventListener('osChanged', updateRegistry);

    document.addEventListener('DOMContentLoaded', () => {
      const savedAbi = localStorage.getItem('lasc_abi');
      if (savedAbi) {
        updateRegistry();
      }
    });
  </script>
</Layout>
