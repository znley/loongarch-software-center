---
import Layout from '../layouts/Layout.astro';
import { getEndpoints } from '../lib/data';

const endpoints = getEndpoints();
const registryConfig = endpoints['container_registry'];
---

<Layout title="容器镜像">
  <div class="max-w-2xl mx-auto">
    <h1 class="text-2xl font-bold mb-2 text-center text-gray-800">容器镜像仓库</h1>
    <p class="text-gray-500 text-center mb-8">获取容器镜像仓库地址和配置方法</p>

    <div id="no-os-hint" class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 mb-8">
      <p class="text-yellow-800 text-sm">
        请先在右上角选择您的操作系统
      </p>
    </div>

    <div id="registry-container" class="hidden space-y-6">
      <!-- 简介 -->
      <div class="bg-white border border-gray-200 rounded-lg p-6">
        <h2 class="font-medium text-gray-800 mb-2">简介</h2>
        <p class="text-sm text-gray-600 leading-relaxed">
          LoongArch 容器镜像仓库提供适用于龙架构的容器镜像，支持 Docker 和 Podman 等容器运行时。
        </p>
      </div>

      <!-- 仓库地址 -->
      <div class="bg-white border border-gray-200 rounded-lg p-6">
        <h2 class="font-medium text-gray-800 mb-2">仓库地址</h2>
        <div class="bg-gray-50 border border-gray-100 rounded px-4 py-3 mb-4">
          <code id="registry-url" class="text-sm text-gray-700 break-all"></code>
        </div>
        <a id="registry-link" href="#" target="_blank" class="inline-block px-4 py-2 bg-blue-500 text-white text-sm rounded hover:bg-blue-600 transition">
          访问仓库
        </a>
      </div>

      <!-- 使用说明 -->
      <div class="bg-white border border-gray-200 rounded-lg p-6">
        <h2 class="font-medium text-gray-800 mb-3">使用说明</h2>
        <div class="space-y-3 text-sm text-gray-600">
          <div>
            <p class="font-medium text-gray-700 mb-1">拉取镜像</p>
            <div class="bg-gray-50 border border-gray-100 rounded px-4 py-2">
              <code id="pull-command" class="text-gray-700"></code>
            </div>
          </div>
          <div>
            <p class="font-medium text-gray-700 mb-1">Docker 配置</p>
            <pre class="bg-gray-50 border border-gray-100 rounded px-4 py-2 text-gray-700 overflow-x-auto whitespace-pre-wrap"><code id="docker-config"></code></pre>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script define:vars={{ registryConfig }}>
    function updateRegistry() {
      const abi = localStorage.getItem('lasc_abi');
      const noOsHint = document.getElementById('no-os-hint');
      const container = document.getElementById('registry-container');

      if (!abi || !registryConfig) {
        noOsHint?.classList.remove('hidden');
        container?.classList.add('hidden');
        return;
      }

      const url = registryConfig.abis[abi];
      if (!url) {
        noOsHint?.classList.remove('hidden');
        container?.classList.add('hidden');
        return;
      }

      noOsHint?.classList.add('hidden');
      container?.classList.remove('hidden');

      document.getElementById('registry-url').textContent = url;
      document.getElementById('registry-link').href = url;
      document.getElementById('pull-command').textContent = registryConfig.command.replace('{url}', url);
      document.getElementById('docker-config').textContent = registryConfig.config.replace('{url}', url);
    }

    window.addEventListener('osChanged', updateRegistry);

    document.addEventListener('DOMContentLoaded', () => {
      const savedAbi = localStorage.getItem('lasc_abi');
      if (savedAbi) {
        updateRegistry();
      }
    });
  </script>
</Layout>
